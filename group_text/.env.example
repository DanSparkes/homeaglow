# Local environment example for Django
# Copy this file to .env and customize values for your machine.

SECRET_KEY=replace-me-with-a-secure-secret
DEBUG=True
DATABASE_URL=postgres://postgres:postgres_pass@db:5432/django_db
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
